# mnemos — environment configuration template.
# Copy to `.env` and edit. None of these are strictly required for local
# development — every variable has a sensible default in mnemos.config.
# docker-compose passes ANTHROPIC_API_KEY through from the host shell.

# --- Storage ---
MNEMOS_DATABASE_URL=postgresql+psycopg://mnemos:mnemos@localhost:5432/mnemos
MNEMOS_QDRANT_URL=http://localhost:6333
MNEMOS_QDRANT_COLLECTION=mnemos

# --- Embeddings ---
MNEMOS_EMBEDDING_MODEL=BAAI/bge-m3
MNEMOS_EMBEDDING_DIM=1024
MNEMOS_SPARSE_MODEL=Qdrant/bm25
MNEMOS_RRF_PREFETCH_LIMIT=50

# --- Temporal decay ---
# w(t) = exp(-lambda_i * delta_days)
# Default half-lives: low ~14d, normal ~35d, high ~140d.
MNEMOS_APPLY_DECAY=true
MNEMOS_DECAY_LAMBDA_LOW=0.05
MNEMOS_DECAY_LAMBDA_NORMAL=0.02
MNEMOS_DECAY_LAMBDA_HIGH=0.005

# --- Eviction composite score ---
# score = w_I*importance + w_R*recency_weight + w_A*log1p(access_count)
MNEMOS_EVICTION_W_IMPORTANCE=1.0
MNEMOS_EVICTION_W_RECENCY=1.0
MNEMOS_EVICTION_W_ACCESS=0.5

# --- Contradiction: LLM judge ---
# Requires ANTHROPIC_API_KEY in the same env; without it /contradiction/detect
# returns 503 and `make eval-contradiction` will be skipped.
MNEMOS_JUDGE_MODEL=claude-haiku-4-5
MNEMOS_JUDGE_MAX_TOKENS=256
ANTHROPIC_API_KEY=

# --- Contradiction: NLI baseline ---
# Local, no API key required.
MNEMOS_NLI_MODEL=cross-encoder/nli-deberta-v3-base
MNEMOS_NLI_THRESHOLD=0.5
